#version 450

layout(local_size_x = 8, local_size_y = 8) in;
#ifdef MULTISAMPLE
layout(set = 0, binding = 0) uniform sampler2DMS source_depth;
#else
layout(set = 0, binding = 0) uniform sampler2D source_depth;
#endif
layout(r32f, set = 0, binding = 1) uniform writeonly image2D destination;
layout(push_constant) uniform Resolve {
  ivec2 source_offset;
  ivec2 destination_offset;
  ivec2 extent;
  int sample_index;
  float depth_scale;
} resolve;

void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(pixel, resolve.extent))) {
    return;
  }
  ivec2 source = resolve.source_offset + pixel;
#ifdef MULTISAMPLE
  float depth = texelFetch(source_depth, source, resolve.sample_index).r;
#else
  float depth = texelFetch(source_depth, source, 0).r;
#endif
  imageStore(destination, resolve.destination_offset + pixel, vec4(depth * resolve.depth_scale, 0, 0, 1));
}
